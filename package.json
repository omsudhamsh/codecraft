{
  "name": "codecraft",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CapEx-AI Practice Studio - a simulation of the Capgemini Exceller Round 2 AI-Assisted Full-Stack Coding Assessment.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verify": "node scripts/verify.mjs",
    "verify:solved": "node scripts/verify.mjs --solved",
    "e2e": "node scripts/e2e.mjs",
    "e2e:auth": "node scripts/e2e.mjs --auth",
    "check": "npm run verify && npm run verify:solved"
  },
  "dependencies": {
    "@clerk/react": "^6.17.8",
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.2",
    "tailwindcss": "^4.0.0",
    "vite": "^5.4.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
