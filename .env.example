# Copy to .env.local and fill in the values from
# https://dashboard.clerk.com → your app → API keys
#
# The publishable key is designed to be public and is bundled into the client.
# Never put CLERK_SECRET_KEY in this file's VITE_ prefixed counterpart or in src/.

VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Server-only. Only needed if you later add a real backend; the app never reads it.
CLERK_SECRET_KEY=sk_test_replace_me
